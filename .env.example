# Founder OS — environment variable template.
# Copy to `.env` (gitignored) for local dev, or inject these names via your
# secrets manager in production. NEVER commit real values.
# See DEPLOYMENT.md for what each variable does and what breaks if it is missing.

# --- Required: founder login ---
FOUNDER_EMAIL=
FOUNDER_PASSWORD=

# --- Optional: Google Sign-In (second, additional login method) ---
# Both required together to enable the "Continue with Google" button; if
# either is unset, GET /api/auth/google returns a clean 500 and founder
# email/password login is completely unaffected.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional: defaults to http://localhost:{PORT}/api/auth/google/callback.
# Must be set explicitly in production to the real public callback URL, and
# must exactly match the redirect URI registered in the Google Cloud
# Console OAuth client.
GOOGLE_REDIRECT_URI=

# --- Recommended: session + runtime mode ---
# Stable secret so sessions survive restarts (random per-process fallback otherwise).
SESSION_SECRET=
# Set to "production" behind TLS to enable the Secure cookie attribute.
NODE_ENV=

# --- Optional: server networking ---
# Single port for both the API and the SPA. Defaults to 4173 if unset.
PORT=

# --- Optional: research source credentials ---
# GitHub search runs unauthenticated without this (low rate limit); token raises quota.
GITHUB_TOKEN=
# Required for the YouTube research source; that source is skipped if unset.
YOUTUBE_API_KEY=
# Stack Exchange search runs without this at lower quota; key raises quota.
STACK_EXCHANGE_KEY=

# --- Optional: logging ---
# Log verbosity level.
AGENT_FACTORY_LOG_LEVEL=
# Set to "json" for structured logs; anything else emits text logs.
AGENT_FACTORY_LOG_FORMAT=

# --- Optional: durable memory (Supabase) ---
# When BOTH are set, the memory engine persists to Supabase instead of the
# volatile in-process store (falls back to in-memory if either is unset, so
# existing setups are unaffected). Apply supabase/migrations/0001_founder_os_memory.sql
# once to the project first. SUPABASE_SERVICE_ROLE_KEY is a SERVER-ONLY secret
# (bypasses RLS) — never expose it to the frontend or commit it.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Optional: Founder OS runtime CLI (founder doctor/run/agent/tools/models/config) ---
# Sandbox root every file/shell/git tool call is contained to. Defaults to the repo root.
FOUNDER_WORKSPACE=
# Local Ollama daemon base URL. Defaults to http://127.0.0.1:11434.
OLLAMA_HOST=
# Local model id used when an agent/command doesn't specify one. Defaults to "llama3.1".
FOUNDER_DEFAULT_MODEL=
# JSON object mapping a Claude-era frontmatter model hint to a real local
# model id, e.g. {"opus":"llama3.1:70b","sonnet":"llama3.1","haiku":"llama3.2"}.
# Purely configuration-driven — never hardcoded, never required.
FOUNDER_MODEL_ALIASES=
# Cap on the tool-call back-and-forth per agent execution. Defaults to 5.
FOUNDER_MAX_TOOL_TURNS=
# Seconds an "ask-user" tool approval waits before being treated as denied. Defaults to 300.
FOUNDER_APPROVAL_TIMEOUT_SECONDS=

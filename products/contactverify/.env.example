# ContactVerify environment variables. See shared/platform/.env.example
# for the full reference — every variable there is also read by this app
# via @founder-os/platform. No real values, ever, per standards/security.md.

PLATFORM_APP_ID=contactverify
PLATFORM_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/contactverify
PLATFORM_REDIS_URL=redis://localhost:6379
PLATFORM_SESSION_SECRET=
PLATFORM_ENCRYPTION_KEY=

# ContactVerify's own product-specific tables live in the same physical
# database as the platform tables above, in their own Postgres schema/
# namespace, per shared/platform/README.md's per-product setup step 3.
CONTACTVERIFY_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/contactverify?schema=contactverify_app

# Optional: the AI Contact Health Engine (Pro tier) requires an AI
# provider — see shared/platform/.env.example. Leave blank in Phase 1;
# that feature fails closed with a clear "not configured" state.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional: billing — see shared/platform/.env.example. Leave blank in
# Phase 1; checkout/portal/webhooks fail closed until both are set.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_STARTER_MONTHLY=
STRIPE_PRICE_ID_PRO_MONTHLY=

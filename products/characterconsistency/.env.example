# CharacterConsistency environment variables. See shared/platform/.env.example
# for the full reference — every variable there is also read by this app
# via @founder-os/platform. No real values, ever, per standards/security.md.

PLATFORM_APP_ID=characterconsistency
PLATFORM_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/characterconsistency
PLATFORM_REDIS_URL=redis://localhost:6379
PLATFORM_SESSION_SECRET=
PLATFORM_ENCRYPTION_KEY=

# CharacterConsistency's own product-specific tables live in the same
# physical database as the platform tables above, in their own Postgres
# schema/namespace, per shared/platform/README.md's per-product setup
# step 3.
CHARACTERCONSISTENCY_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/characterconsistency?schema=characterconsistency_app

# Optional: AI Character DNA expansion (Pro tier) requires an AI
# provider — see shared/platform/.env.example. Leave blank in Phase 1;
# that feature fails closed with a clear "not configured" state. Actual
# pixel/image generation requires a Phase 2 image-gen provider (Stability,
# DALL-E, Midjourney) not wired in Phase 1 — this product's Phase 1
# deliverable is the locked, reusable prompt specification, not rendered
# pixels.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional: billing — see shared/platform/.env.example. Leave blank in
# Phase 1; checkout/portal/webhooks fail closed until both are set.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_STARTER_MONTHLY=
STRIPE_PRICE_ID_PRO_MONTHLY=

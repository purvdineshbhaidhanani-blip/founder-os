// IncidentTriage product-specific schema. See products/spendgov/prisma/schema.prisma
// for the documented rationale on why organizationId/userId columns here
// are plain indexed strings rather than Prisma relations, and why this
// schema lives in its own Postgres namespace alongside
// @founder-os/platform's tables.

generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/incidenttriage-client"
}

datasource db {
  provider = "postgresql"
  url      = env("INCIDENTTRIAGE_DATABASE_URL")
}

enum ServiceStatus {
  healthy
  degraded
  down

  @@map("service_status")
}

model Service {
  id             String        @id @default(uuid())
  organizationId String        @map("organization_id")
  name           String
  status         ServiceStatus @default(healthy)
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  alerts    Alert[]
  incidents Incident[]

  @@unique([organizationId, name], map: "uq_services_org_name")
  @@index([organizationId])
  @@map("services")
}

enum AlertSeverity {
  info
  warning
  critical

  @@map("alert_severity")
}

model Alert {
  id             String        @id @default(uuid())
  organizationId String        @map("organization_id")
  serviceId      String        @map("service_id")
  incidentId     String?       @map("incident_id")
  source         String
  message        String
  severity       AlertSeverity @default(warning)
  occurredAt     DateTime      @map("occurred_at")
  createdAt      DateTime      @default(now()) @map("created_at")

  service  Service   @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  incident Incident? @relation(fields: [incidentId], references: [id], onDelete: SetNull)

  @@index([organizationId, serviceId, occurredAt])
  @@index([organizationId, incidentId])
  @@map("alerts")
}

enum IncidentStatus {
  open
  investigating
  resolved

  @@map("incident_status")
}

model Incident {
  id             String         @id @default(uuid())
  organizationId String         @map("organization_id")
  serviceId      String         @map("service_id")
  title          String
  status         IncidentStatus @default(open)
  severity       AlertSeverity  @default(warning)
  startedAt      DateTime       @default(now()) @map("started_at")
  resolvedAt     DateTime?      @map("resolved_at")

  service            Service             @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  alerts             Alert[]
  rootCauseAnalysis  RootCauseAnalysis?

  @@index([organizationId, status])
  @@index([organizationId, startedAt])
  @@map("incidents")
}

model RootCauseAnalysis {
  id                      String   @id @default(uuid())
  organizationId          String   @map("organization_id")
  incidentId              String   @unique(map: "uq_root_cause_analyses_incident_id") @map("incident_id")
  hypothesis              String
  confidence              Int
  culpritService          String   @map("culprit_service")
  suggestedFix            String   @map("suggested_fix")
  estimatedRecoveryMinutes Int     @map("estimated_recovery_minutes")
  generatedAt             DateTime @default(now()) @map("generated_at")

  incident Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("root_cause_analyses")
}

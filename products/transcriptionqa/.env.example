# TranscriptionQA environment variables. See shared/platform/.env.example
# for the full reference — every variable there is also read by this app
# via @founder-os/platform. No real values, ever, per standards/security.md.

PLATFORM_APP_ID=transcriptionqa
PLATFORM_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/transcriptionqa
PLATFORM_REDIS_URL=redis://localhost:6379
PLATFORM_SESSION_SECRET=
PLATFORM_ENCRYPTION_KEY=

# TranscriptionQA's own product-specific tables live in the same
# physical database as the platform tables above, in their own Postgres
# schema/namespace, per shared/platform/README.md's per-product setup
# step 3.
TRANSCRIPTIONQA_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/transcriptionqa?schema=transcriptionqa_app

# Optional: AI Accuracy Copilot (Pro tier) requires an AI provider —
# see shared/platform/.env.example. Leave blank in Phase 1; that
# feature fails closed with a clear "not configured" state.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Phase 1 reviews a transcript however it was produced — no ASR/audio
# processing provider is wired. Callers submit the transcript text and
# speaker-labeled segments directly (as exported from any transcription
# source) rather than uploading raw audio for TranscriptionQA to
# transcribe itself; "processing minutes" is self-reported by the
# caller as a usage-metering proxy rather than measured from real audio
# duration. A real audio ingestion/ASR pipeline is Phase 2, per
# docs/PRODUCT_IDENTITY.md §7's "No external ASR provider credentials
# required to run Phase 1 core QA review."

# Optional: billing — see shared/platform/.env.example. Leave blank in
# Phase 1; checkout/portal/webhooks fail closed until both are set.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_STARTER_MONTHLY=
STRIPE_PRICE_ID_PRO_MONTHLY=

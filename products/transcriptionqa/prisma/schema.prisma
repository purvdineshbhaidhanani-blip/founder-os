// TranscriptionQA product-specific schema. See products/spendgov/prisma/schema.prisma
// for the documented rationale on why organizationId/userId columns here
// are plain indexed strings rather than Prisma relations, and why this
// schema lives in its own Postgres namespace alongside
// @founder-os/platform's tables.
//
// Phase 1 reviews a transcript however it was produced — no ASR/audio
// processing provider is wired. Callers submit transcript text and
// speaker-labeled segments directly (as exported from any transcription
// source), not raw audio for TranscriptionQA to transcribe itself;
// `estimatedMinutes` is self-reported by the caller as a usage-metering
// proxy rather than measured from real audio duration, per
// products/transcriptionqa/docs/PRODUCT_IDENTITY.md §7's "No external
// ASR provider credentials required to run Phase 1 core QA review."

generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/transcriptionqa-client"
}

datasource db {
  provider = "postgresql"
  url      = env("TRANSCRIPTIONQA_DATABASE_URL")
}

model Transcript {
  id                String    @id @default(uuid())
  organizationId    String    @map("organization_id")
  createdByUserId   String    @map("created_by_user_id")
  title             String
  sourceLabel       String    @map("source_label")
  estimatedMinutes  Float     @default(0) @map("estimated_minutes")
  wordCount         Int       @default(0) @map("word_count")
  accuracyScore     Int       @default(100) @map("accuracy_score")
  summary           String?
  copilotRiskLevel  String?   @map("copilot_risk_level")
  copilotHighlightedRisks String[] @map("copilot_highlighted_risks")
  copilotGeneratedAt DateTime? @map("copilot_generated_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  segments TranscriptSegment[]
  findings Finding[]

  @@index([organizationId])
  @@index([organizationId, createdAt])
  @@map("transcripts")
}

model TranscriptSegment {
  id             String @id @default(uuid())
  organizationId String @map("organization_id")
  transcriptId   String @map("transcript_id")
  sequenceIndex  Int    @map("sequence_index")
  speakerLabel   String @map("speaker_label")
  text           String

  transcript Transcript @relation(fields: [transcriptId], references: [id], onDelete: Cascade)
  findings   Finding[]

  @@index([organizationId, transcriptId])
  @@map("transcript_segments")
}

model Finding {
  id                  String    @id @default(uuid())
  organizationId      String    @map("organization_id")
  transcriptId        String    @map("transcript_id")
  segmentId           String    @map("segment_id")
  ruleId              String    @map("rule_id")
  category            String
  severity            String
  title               String
  description         String
  suggestedCorrection String?   @map("suggested_correction")
  status              String    @default("open")
  createdAt           DateTime  @default(now()) @map("created_at")
  resolvedAt          DateTime? @map("resolved_at")

  transcript Transcript        @relation(fields: [transcriptId], references: [id], onDelete: Cascade)
  segment    TranscriptSegment @relation(fields: [segmentId], references: [id], onDelete: Cascade)

  @@index([organizationId, transcriptId])
  @@index([organizationId, status])
  @@map("findings")
}

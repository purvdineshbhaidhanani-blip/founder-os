# SchemaLint environment variables. See shared/platform/.env.example for
# the full reference — every variable there is also read by this app
# via @founder-os/platform. No real values, ever, per standards/security.md.

PLATFORM_APP_ID=schemalint
PLATFORM_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/schemalint
PLATFORM_REDIS_URL=redis://localhost:6379
PLATFORM_SESSION_SECRET=
PLATFORM_ENCRYPTION_KEY=

# SchemaLint's own product-specific tables live in the same physical
# database as the platform tables above, in their own Postgres
# schema/namespace, per shared/platform/README.md's per-product setup
# step 3.
SCHEMALINT_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/schemalint?schema=schemalint_app

# Optional: AI Database Architect (Pro tier) requires an AI provider —
# see shared/platform/.env.example. Leave blank in Phase 1; that
# feature fails closed with a clear "not configured" state.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Phase 1 is read-only schema introspection/import only — no live
# database write access. Callers submit a schema snapshot (tables,
# columns, foreign keys, indexes) as exported/introspected from their
# own database rather than granting SchemaLint a live connection; a
# live-connector integration (PostgreSQL/MySQL/SQLite/SQL Server) is
# built and wired but disabled until Phase 2 credentials, per
# docs/PRODUCT_IDENTITY.md §7.

# Optional: billing — see shared/platform/.env.example. Leave blank in
# Phase 1; checkout/portal/webhooks fail closed until both are set.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_STARTER_MONTHLY=
STRIPE_PRICE_ID_PRO_MONTHLY=

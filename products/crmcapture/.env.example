# CRMCapture environment variables. See shared/platform/.env.example for
# the full reference — every variable there is also read by this app via
# @founder-os/platform. No real values, ever, per standards/security.md.

PLATFORM_APP_ID=crmcapture
PLATFORM_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/crmcapture
PLATFORM_REDIS_URL=redis://localhost:6379
PLATFORM_SESSION_SECRET=
PLATFORM_ENCRYPTION_KEY=

# CRMCapture's own product-specific tables live in the same physical
# database as the platform tables above, in their own Postgres schema/
# namespace, per shared/platform/README.md's per-product setup step 3.
CRMCAPTURE_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/crmcapture?schema=crmcapture_app

# Optional: AI lead extraction and the AI Sales Assistant (Pro tier)
# require an AI provider — see shared/platform/.env.example. Leave blank
# in Phase 1; those features fail closed with a clear "not configured" state.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional: billing — see shared/platform/.env.example. Leave blank in
# Phase 1; checkout/portal/webhooks fail closed until both are set.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_STARTER_MONTHLY=
STRIPE_PRICE_ID_PRO_MONTHLY=

# SpendGov environment variables. See shared/platform/.env.example for the
# full reference — every variable there is also read by this app via
# @founder-os/platform. No real values, ever, per standards/security.md.

PLATFORM_APP_ID=spendgov
PLATFORM_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/spendgov
PLATFORM_REDIS_URL=redis://localhost:6379
PLATFORM_SESSION_SECRET=
PLATFORM_ENCRYPTION_KEY=

# SpendGov's own product-specific tables live in the same physical database
# as the platform tables above (one database per product, per
# shared/platform/README.md), but in their own Postgres schema/namespace
# ("spendgov_app") so this app's migration history never collides with
# @founder-os/platform's _prisma_migrations bookkeeping table.
SPENDGOV_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/spendgov?schema=spendgov_app

# Optional: AI CFO Copilot (Pro tier) requires an AI provider — see
# shared/platform/.env.example. Leave blank in Phase 1; the feature fails
# closed with a clear "not configured" state, per standards/security.md.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional: billing — see shared/platform/.env.example. Leave blank in
# Phase 1; checkout/portal/webhooks fail closed until both are set.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

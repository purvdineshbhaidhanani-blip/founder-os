# AuthStartup environment variables. See shared/platform/.env.example for
# the full reference — every variable there is also read by this app via
# @founder-os/platform. No real values, ever, per standards/security.md.

PLATFORM_APP_ID=authstartup
PLATFORM_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/authstartup
PLATFORM_REDIS_URL=redis://localhost:6379
PLATFORM_SESSION_SECRET=
PLATFORM_ENCRYPTION_KEY=

# AuthStartup's own product-specific tables (projects, API keys, the
# end-user pools AuthStartup's customers manage) live in the same
# physical database as the platform tables above, in their own Postgres
# schema/namespace, per shared/platform/README.md's per-product setup
# step 3. Note: PLATFORM_* tables here are for AuthStartup's OWN
# developer-facing accounts (the people who sign up to AuthStartup to
# manage projects) — end users of a project are a separate, project-
# scoped identity pool modeled entirely within AUTHSTARTUP_DATABASE_URL.
AUTHSTARTUP_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/authstartup?schema=authstartup_app

# Optional: the AI Security Advisor (Pro tier) requires an AI provider —
# see shared/platform/.env.example. Leave blank in Phase 1; that feature
# fails closed with a clear "not configured" state.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional: billing — see shared/platform/.env.example. Leave blank in
# Phase 1; checkout/portal/webhooks fail closed until both are set.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_STARTER_MONTHLY=
STRIPE_PRICE_ID_PRO_MONTHLY=

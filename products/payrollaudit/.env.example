# PayrollAudit environment variables. See shared/platform/.env.example
# for the full reference — every variable there is also read by this app
# via @founder-os/platform. No real values, ever, per standards/security.md.

PLATFORM_APP_ID=payrollaudit
PLATFORM_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/payrollaudit
PLATFORM_REDIS_URL=redis://localhost:6379
PLATFORM_SESSION_SECRET=
PLATFORM_ENCRYPTION_KEY=

# PayrollAudit's own product-specific tables live in the same physical
# database as the platform tables above, in their own Postgres
# schema/namespace, per shared/platform/README.md's per-product setup
# step 3.
PAYROLLAUDIT_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/payrollaudit?schema=payrollaudit_app

# Optional: AI Payroll Copilot (Pro tier) requires an AI provider — see
# shared/platform/.env.example. Leave blank in Phase 1; that feature
# fails closed with a clear "not configured" state.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Phase 1 tax/compliance validation uses a single, illustrative
# progressive tax-bracket table (see lib/services/payroll-engine.ts) as
# a placeholder for one well-validated jurisdiction, per
# docs/PRODUCT_IDENTITY.md §27 "launch with one or two well-validated
# jurisdictions." No live payroll-system write access is requested in
# Phase 1 — import-based validation only; deeper live payroll-system
# connectors and additional jurisdiction rule libraries are Phase 2.

# Optional: billing — see shared/platform/.env.example. Leave blank in
# Phase 1; checkout/portal/webhooks fail closed until both are set.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_STARTER_MONTHLY=
STRIPE_PRICE_ID_PRO_MONTHLY=

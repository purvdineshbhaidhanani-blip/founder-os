{
  "name": "agent-factory",
  "version": "1.0.0",
  "description": "AI Founder OS Agent Factory — the internal platform that designs, generates, validates and registers every Claude Code agent used across the organization.",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=18.18.0"
  },
  "bin": {
    "agent-factory": "./dist/cli/index.js"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli/index.ts",
    "factory": "tsx src/cli/index.ts",
    "generate:engineering": "tsx src/departments/generate.ts",
    "generate:intelligence": "tsx src/intelligence/generate.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "web": "tsx src/web-server.ts",
    "web:build": "npm run build && vite build"
  },
  "dependencies": {
    "axios": "^1.7.7",
    "commander": "^12.1.0",
    "express": "^4.19.2",
    "express-session": "^1.17.3",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.24.1",
    "yaml": "^2.5.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/express-session": "^1.17.11",
    "@types/node": "^20.14.2",
    "@types/passport-google-oauth20": "^2.0.16",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^7.13.1",
    "@typescript-eslint/parser": "^7.13.1",
    "@vitejs/plugin-react": "^4.3.0",
    "eslint": "^8.57.0",
    "prettier": "^3.3.2",
    "tsx": "^4.16.0",
    "typescript": "^5.5.2",
    "vite": "^5.3.1",
    "vitest": "^1.6.0"
  }
}

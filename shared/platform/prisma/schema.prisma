// Shared platform schema — Phase A (Authentication, User Management, Organizations/Teams/RBAC).
// Naming conventions: standards/database.md (snake_case tables/columns, plural table names).
// Multi-app isolation: every product-facing table carries app_id — see shared/platform/ARCHITECTURE.md.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("PLATFORM_DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Users & credentials
// ---------------------------------------------------------------------------

model User {
  id              String    @id @default(uuid())
  appId           String    @map("app_id")
  email           String
  emailVerifiedAt DateTime? @map("email_verified_at")
  passwordHash    String?   @map("password_hash")
  displayName     String    @map("display_name")
  avatarUrl       String?   @map("avatar_url")
  status          UserStatus @default(active)
  settings        Json      @default("{}") // account settings: timezone, locale, notification prefs — JSON to avoid a migration per new setting
  lastLoginAt     DateTime? @map("last_login_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")

  oauthAccounts    OAuthAccount[]
  sessions         Session[]
  mfaFactors       MfaFactor[]
  passwordResets   PasswordResetToken[]
  magicLinks       MagicLinkToken[]
  memberships      OrganizationMember[]
  sentInvitations  Invitation[]          @relation("InvitationSender")
  auditLogEntries  AuditLogEntry[]       @relation("AuditLogActor")

  @@unique([appId, email], name: "uq_users_app_id_email")
  @@index([appId])
  @@index([appId, status])
  @@map("users")
}

enum UserStatus {
  active
  invited
  suspended
  deactivated

  @@map("user_status")
}

model OAuthAccount {
  id             String   @id @default(uuid())
  userId         String   @map("user_id")
  provider       OAuthProvider
  providerUserId String   @map("provider_user_id")
  accessToken    String?  @map("access_token") // encrypted at the application layer before write
  refreshToken   String?  @map("refresh_token") // encrypted at the application layer before write
  expiresAt      DateTime? @map("expires_at")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId], name: "uq_oauth_accounts_provider_provider_user_id")
  @@index([userId])
  @@map("oauth_accounts")
}

enum OAuthProvider {
  google
  microsoft
  github

  @@map("oauth_provider")
}

// ---------------------------------------------------------------------------
// Sessions, MFA, password reset, magic links
// ---------------------------------------------------------------------------

model Session {
  id           String   @id @default(uuid())
  userId       String   @map("user_id")
  tokenHash    String   @map("token_hash") // sha256 of the opaque session token; raw token never stored
  ipAddress    String?  @map("ip_address")
  userAgent    String?  @map("user_agent")
  createdAt    DateTime @default(now()) @map("created_at")
  lastSeenAt   DateTime @default(now()) @map("last_seen_at")
  expiresAt    DateTime @map("expires_at")
  revokedAt    DateTime? @map("revoked_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tokenHash], name: "uq_sessions_token_hash")
  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model MfaFactor {
  id         String     @id @default(uuid())
  userId     String     @map("user_id")
  type       MfaType    @default(totp)
  secret     String     // encrypted at the application layer before write
  verifiedAt DateTime?  @map("verified_at")
  createdAt  DateTime   @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("mfa_factors")
}

enum MfaType {
  totp

  @@map("mfa_type")
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  tokenHash String   @map("token_hash")
  expiresAt DateTime @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tokenHash], name: "uq_password_reset_tokens_token_hash")
  @@index([userId])
  @@map("password_reset_tokens")
}

model MagicLinkToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  tokenHash String   @map("token_hash")
  expiresAt DateTime @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tokenHash], name: "uq_magic_link_tokens_token_hash")
  @@index([userId])
  @@map("magic_link_tokens")
}

// ---------------------------------------------------------------------------
// Organizations, teams, membership, roles, invitations
// ---------------------------------------------------------------------------

model Organization {
  id        String   @id @default(uuid())
  appId     String   @map("app_id")
  name      String
  slug      String
  settings  Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  members     OrganizationMember[]
  teams       Team[]
  invitations Invitation[]
  auditLog    AuditLogEntry[]

  @@unique([appId, slug], name: "uq_organizations_app_id_slug")
  @@index([appId])
  @@map("organizations")
}

model Team {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  name           String
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  members      TeamMember[]

  @@index([organizationId])
  @@map("teams")
}

model OrganizationMember {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  userId         String   @map("user_id")
  role           OrgRole  @default(member)
  productRole    String?  @map("product_role") // product-specific role extension, e.g. "finance_lead"
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId], name: "uq_organization_members_org_user")
  @@index([organizationId])
  @@index([userId])
  @@map("organization_members")
}

enum OrgRole {
  owner
  admin
  member

  @@map("org_role")
}

model TeamMember {
  id        String   @id @default(uuid())
  teamId    String   @map("team_id")
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId], name: "uq_team_members_team_user")
  @@index([teamId])
  @@index([userId])
  @@map("team_members")
}

model Invitation {
  id             String           @id @default(uuid())
  organizationId String           @map("organization_id")
  email          String
  role           OrgRole          @default(member)
  productRole    String?          @map("product_role")
  tokenHash      String           @map("token_hash")
  invitedById    String           @map("invited_by_id")
  status         InvitationStatus @default(pending)
  expiresAt      DateTime         @map("expires_at")
  acceptedAt     DateTime?        @map("accepted_at")
  createdAt      DateTime         @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy    User         @relation("InvitationSender", fields: [invitedById], references: [id])

  @@unique([tokenHash], name: "uq_invitations_token_hash")
  @@index([organizationId])
  @@index([email])
  @@map("invitations")
}

enum InvitationStatus {
  pending
  accepted
  revoked
  expired

  @@map("invitation_status")
}

// ---------------------------------------------------------------------------
// Audit log (append-only; standards/security.md)
// ---------------------------------------------------------------------------

model AuditLogEntry {
  id             String   @id @default(uuid())
  appId          String   @map("app_id")
  organizationId String?  @map("organization_id")
  actorId        String?  @map("actor_id")
  action         String
  targetType     String   @map("target_type")
  targetId       String?  @map("target_id")
  ipAddress      String?  @map("ip_address")
  metadata       Json     @default("{}")
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  actor        User?         @relation("AuditLogActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([appId])
  @@index([organizationId])
  @@index([actorId])
  @@index([createdAt])
  @@map("audit_log_entries")
}

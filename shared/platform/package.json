{
  "name": "@founder-os/platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Shared authentication, user management, and organizations/RBAC platform used by every product in the portfolio.",
  "engines": {
    "node": ">=20.11.0"
  },
  "exports": {
    "./auth": "./src/auth/index.ts",
    "./users": "./src/users/index.ts",
    "./organizations": "./src/organizations/index.ts",
    "./db": "./src/db/index.ts",
    "./config": "./src/config/index.ts",
    "./errors": "./src/errors/index.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "test:watch": "vitest",
    "prisma:generate": "prisma generate",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy"
  },
  "dependencies": {
    "@prisma/client": "^5.20.0",
    "argon2": "^0.41.1",
    "ioredis": "^5.4.1",
    "jose": "^5.9.6",
    "otplib": "^12.0.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.16.10",
    "prisma": "^5.20.0",
    "typescript": "^5.6.2",
    "vitest": "^2.1.2"
  }
}

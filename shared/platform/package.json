{
  "name": "@founder-os/platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Shared authentication, user management, and organizations/RBAC platform used by every product in the portfolio.",
  "engines": {
    "node": ">=20.11.0"
  },
  "exports": {
    "./auth": { "types": "./dist/auth/index.d.ts", "default": "./dist/auth/index.js" },
    "./users": { "types": "./dist/users/index.d.ts", "default": "./dist/users/index.js" },
    "./organizations": { "types": "./dist/organizations/index.d.ts", "default": "./dist/organizations/index.js" },
    "./db": { "types": "./dist/db/index.d.ts", "default": "./dist/db/index.js" },
    "./config": { "types": "./dist/config/index.d.ts", "default": "./dist/config/index.js" },
    "./errors": { "types": "./dist/errors/index.d.ts", "default": "./dist/errors/index.js" },
    "./logging": { "types": "./dist/logging/index.d.ts", "default": "./dist/logging/index.js" },
    "./api": { "types": "./dist/api/index.d.ts", "default": "./dist/api/index.js" },
    "./ai": { "types": "./dist/ai/index.d.ts", "default": "./dist/ai/index.js" },
    "./billing": { "types": "./dist/billing/index.d.ts", "default": "./dist/billing/index.js" },
    "./storage": { "types": "./dist/storage/index.d.ts", "default": "./dist/storage/index.js" },
    "./notifications": { "types": "./dist/notifications/index.d.ts", "default": "./dist/notifications/index.js" },
    "./reporting": { "types": "./dist/reporting/index.d.ts", "default": "./dist/reporting/index.js" },
    "./search": { "types": "./dist/search/index.d.ts", "default": "./dist/search/index.js" },
    "./analytics": { "types": "./dist/analytics/index.d.ts", "default": "./dist/analytics/index.js" },
    "./integrations": { "types": "./dist/integrations/index.d.ts", "default": "./dist/integrations/index.js" },
    "./monitoring": { "types": "./dist/monitoring/index.d.ts", "default": "./dist/monitoring/index.js" },
    "./settings": { "types": "./dist/settings/index.d.ts", "default": "./dist/settings/index.js" },
    "./audit": { "types": "./dist/audit/index.d.ts", "default": "./dist/audit/index.js" },
    "./crypto": { "types": "./dist/crypto/index.d.ts", "default": "./dist/crypto/index.js" }
  },
  "scripts": {
    "prepare": "npm run build",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "lint": "eslint src",
    "test": "vitest run",
    "test:watch": "vitest",
    "prisma:generate": "prisma generate",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.30.1",
    "@aws-sdk/client-s3": "^3.679.0",
    "@aws-sdk/s3-request-presigner": "^3.679.0",
    "@prisma/client": "^5.20.0",
    "argon2": "^0.41.1",
    "cron-parser": "^4.9.0",
    "exceljs": "^4.4.0",
    "ioredis": "^5.4.1",
    "jose": "^5.9.6",
    "nodemailer": "^6.9.15",
    "openai": "^4.68.4",
    "otplib": "^12.0.1",
    "pdf-lib": "^1.17.1",
    "stripe": "^17.2.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.16.10",
    "@types/nodemailer": "^6.4.16",
    "eslint": "^9.39.4",
    "prisma": "^5.20.0",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.63.0",
    "vitest": "^2.1.2"
  }
}

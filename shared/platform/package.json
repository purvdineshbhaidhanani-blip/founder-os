{
  "name": "@founder-os/platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Shared authentication, user management, and organizations/RBAC platform used by every product in the portfolio.",
  "engines": {
    "node": ">=20.11.0"
  },
  "exports": {
    "./auth": "./src/auth/index.ts",
    "./users": "./src/users/index.ts",
    "./organizations": "./src/organizations/index.ts",
    "./db": "./src/db/index.ts",
    "./config": "./src/config/index.ts",
    "./errors": "./src/errors/index.ts",
    "./logging": "./src/logging/index.ts",
    "./api": "./src/api/index.ts",
    "./ai": "./src/ai/index.ts",
    "./billing": "./src/billing/index.ts",
    "./storage": "./src/storage/index.ts",
    "./notifications": "./src/notifications/index.ts",
    "./reporting": "./src/reporting/index.ts",
    "./search": "./src/search/index.ts",
    "./analytics": "./src/analytics/index.ts",
    "./integrations": "./src/integrations/index.ts",
    "./monitoring": "./src/monitoring/index.ts",
    "./settings": "./src/settings/index.ts",
    "./audit": "./src/audit/index.ts",
    "./crypto": "./src/crypto/index.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "lint": "eslint src",
    "test": "vitest run",
    "test:watch": "vitest",
    "prisma:generate": "prisma generate",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.30.1",
    "@aws-sdk/client-s3": "^3.679.0",
    "@aws-sdk/s3-request-presigner": "^3.679.0",
    "@prisma/client": "^5.20.0",
    "argon2": "^0.41.1",
    "cron-parser": "^4.9.0",
    "exceljs": "^4.4.0",
    "ioredis": "^5.4.1",
    "jose": "^5.9.6",
    "nodemailer": "^6.9.15",
    "openai": "^4.68.4",
    "otplib": "^12.0.1",
    "pdf-lib": "^1.17.1",
    "stripe": "^17.2.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.16.10",
    "@types/nodemailer": "^6.4.16",
    "eslint": "^9.39.4",
    "prisma": "^5.20.0",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.63.0",
    "vitest": "^2.1.2"
  }
}

# Shared platform environment variables. Copy relevant entries into each
# product's own .env — every product process that imports @founder-os/platform
# needs these set. No real values, ever, per standards/security.md.

# Which product's tenant space this process serves — e.g. "spendgov",
# "seccorrelate", "codeaudit", "crmcapture", "incidenttriage", "authstartup".
# Required. Determines app_id scoping on every platform query.
PLATFORM_APP_ID=

# PostgreSQL connection string for the platform schema (users, organizations,
# sessions, etc). Required — nothing in this package runs without it.
PLATFORM_DATABASE_URL=

# Redis connection string, used for rate limiting (login attempts, password
# reset / magic link requests). Required.
PLATFORM_REDIS_URL=

# Random secret, at least 32 characters, used to sign short-lived JWTs issued
# from an active session for API/SPA consumption. Required. Generate with:
# `openssl rand -base64 32`
PLATFORM_SESSION_SECRET=

# Random secret, at least 32 characters, used to encrypt OAuth tokens and MFA
# secrets at rest (standards/security.md: "sensitive data at rest... is
# encrypted at the database or application layer"). Required. Generate with:
# `openssl rand -base64 32`
PLATFORM_ENCRYPTION_KEY=

# --- OAuth providers (optional) ---
# Each provider is fully built and wired but stays disabled — sign-in with
# that provider fails closed with a clear "not configured" error — until
# both its client ID and secret are set. No fake/placeholder values.
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_MICROSOFT_CLIENT_ID=
OAUTH_MICROSOFT_CLIENT_SECRET=
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=

# --- Transactional email (optional) ---
# Magic links, password reset, and org invitations all require this. Until
# both are set, those flows return INTEGRATION_NOT_CONFIGURED (503) instead
# of silently failing or crashing.
PLATFORM_EMAIL_FROM=
PLATFORM_EMAIL_PROVIDER_API_KEY=

# --- AI providers (optional) ---
# SH-AI (@founder-os/platform/ai) routes every completion through Anthropic
# by default, with automatic fallback to OpenAI on a retryable failure.
# Fails closed with INTEGRATION_NOT_CONFIGURED until at least one is set.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Billing (optional) ---
# SH-BILL (@founder-os/platform/billing) is fully built and wired — plans,
# entitlements, subscriptions, usage metering all work without Stripe — but
# checkout/billing-portal/webhook handling stays disabled until both are set.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Object storage (optional) ---
# SH-STORAGE (@founder-os/platform/storage) uploads/downloads/signed URLs
# via any S3-compatible provider. Set PLATFORM_STORAGE_ENDPOINT only for
# non-AWS providers (Cloudflare R2, MinIO, etc.) — leave blank for AWS S3.
PLATFORM_STORAGE_BUCKET=
PLATFORM_STORAGE_REGION=
PLATFORM_STORAGE_ACCESS_KEY_ID=
PLATFORM_STORAGE_SECRET_ACCESS_KEY=
PLATFORM_STORAGE_ENDPOINT=

# --- Outbound webhooks (optional) ---
# Gates whether SH-INTEG's outbound delivery dispatcher (Slack/Teams/generic
# webhook notifications) runs in this environment at all. Per-organization
# webhook URLs and signing secrets are stored encrypted in the database via
# SH-INTEG, not here — this only toggles the dispatcher itself. Defaults to
# disabled (unset or any value other than "true").
PLATFORM_WEBHOOKS_ENABLED=

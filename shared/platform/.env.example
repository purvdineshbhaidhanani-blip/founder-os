# Shared platform environment variables. Copy relevant entries into each
# product's own .env — every product process that imports @founder-os/platform
# needs these set. No real values, ever, per standards/security.md.

# Which product's tenant space this process serves — e.g. "spendgov",
# "seccorrelate", "codeaudit", "crmcapture", "incidenttriage", "authstartup".
# Required. Determines app_id scoping on every platform query.
PLATFORM_APP_ID=

# PostgreSQL connection string for the platform schema (users, organizations,
# sessions, etc). Required — nothing in this package runs without it.
PLATFORM_DATABASE_URL=

# Redis connection string, used for rate limiting (login attempts, password
# reset / magic link requests). Required.
PLATFORM_REDIS_URL=

# Random secret, at least 32 characters, used to sign short-lived JWTs issued
# from an active session for API/SPA consumption. Required. Generate with:
# `openssl rand -base64 32`
PLATFORM_SESSION_SECRET=

# Random secret, at least 32 characters, used to encrypt OAuth tokens and MFA
# secrets at rest (standards/security.md: "sensitive data at rest... is
# encrypted at the database or application layer"). Required. Generate with:
# `openssl rand -base64 32`
PLATFORM_ENCRYPTION_KEY=

# --- OAuth providers (optional) ---
# Each provider is fully built and wired but stays disabled — sign-in with
# that provider fails closed with a clear "not configured" error — until
# both its client ID and secret are set. No fake/placeholder values.
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_MICROSOFT_CLIENT_ID=
OAUTH_MICROSOFT_CLIENT_SECRET=
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=

# --- Transactional email (optional) ---
# Magic links, password reset, and org invitations all require this. Until
# both are set, those flows return INTEGRATION_NOT_CONFIGURED (503) instead
# of silently failing or crashing.
PLATFORM_EMAIL_FROM=
PLATFORM_EMAIL_PROVIDER_API_KEY=
